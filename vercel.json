{
  "functions": {
    "api/index.js": {"maxDuration": 30},
    "api/mission.js": {"maxDuration": 30},
    "api/media.js": {"maxDuration": 30},
    "api/operator-dashboard.js": {"maxDuration": 15},
    "api/operator-dashboard-v2.js": {"maxDuration": 15},
    "api/operator-game.js": {"maxDuration": 15},
    "api/operator-profile.js": {"maxDuration": 30},
    "api/operator-replicas.js": {"maxDuration": 30},
    "api/commander-live.js": {"maxDuration": 30},
    "api/light.js": {"maxDuration": 15}
  },
  "rewrites": [
    {"source": "/api/light", "destination": "/api/light.js"},
    {"source": "/api/mission", "destination": "/api/mission.js"},
    {"source": "/api/media", "destination": "/api/media.js"},
    {"source": "/api/operator-dashboard", "destination": "/api/operator-dashboard-v2.js"},
    {"source": "/api/operator-game", "destination": "/api/operator-game.js"},
    {"source": "/api/operator-profile", "destination": "/api/operator-profile.js"},
    {"source": "/api/operator-replicas", "destination": "/api/operator-replicas.js"},
    {"source": "/api/commander-live", "destination": "/api/commander-live.js"},
    {"source": "/api/:path*", "destination": "/api/index.js"},
    {"source": "/:path*/app.js", "destination": "/app.js"},
    {"source": "/:path*/style.css", "destination": "/style.css"},
    {"source": "/:path*/logo.webp", "destination": "/logo.webp"},
    {"source": "/:path*/manifest.webmanifest", "destination": "/manifest.webmanifest"},
    {"source": "/:path*/sw.js", "destination": "/sw.js"},
    {"source": "/((?!api/)(?!.*\\.).*)", "destination": "/index.html"}
  ]
}